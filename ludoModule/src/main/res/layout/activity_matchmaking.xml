<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_match_screen">

    <!-- spotlight beam (CENTER with glow) -->
    <ImageView
        android:id="@+id/spotlight"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="center"
        android:src="@drawable/bg_spotlight"
        android:scaleType="centerCrop"
        android:alpha="0.7"/>

    <!-- content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top spacer -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- avatars row (CENTER PART) -->
        <LinearLayout
            android:id="@+id/rowPlayers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="32dp">

            <!-- you -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgYou"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/ic_user_placeholder"
                    android:elevation="8dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Ludo.Full"
                    app:strokeWidth="3dp"
                    app:strokeColor="@color/white" />

                <TextView
                    android:id="@+id/tvYouName"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center"
                    android:text="You"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_name_pill"
                    android:elevation="4dp"/>
            </LinearLayout>

            <!-- VS -->
            <TextView
                android:id="@+id/tvVS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="22dp"
                android:text="VS"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:shadowColor="#FFD966"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="20"/>

            <!-- opponent -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgOpponent"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/ic_user_placeholder"
                    android:elevation="8dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Ludo.Full"
                    app:strokeWidth="3dp"
                    app:strokeColor="@color/white" />

                <TextView
                    android:id="@+id/tvOpponentName"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center"
                    android:text="Searching..."
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_name_pill"
                    android:elevation="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom spacer -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- searching footer -->
        <TextView
            android:id="@+id/tvSearchingFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Searching for players..."
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="40dp"
            android:layout_gravity="center"
            android:shadowColor="#FFAA33"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="14"/>
    </LinearLayout>

</FrameLayout>
