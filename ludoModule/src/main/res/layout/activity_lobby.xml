<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B2A63"
    android:padding="16dp">

    <!-- Top Coins & Diamonds -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/bg_topbar">

        <TextView
            android:id="@+id/txtCoins"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Coins: 1115"
            android:textColor="#FFD700"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDiamonds"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Diamonds: 150"
            android:textColor="#00E5FF"
            android:textSize="18sp"
            android:gravity="end"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Select Players -->
    <TextView
        android:id="@+id/txtSelectPlayers"
        android:layout_below="@id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECT PLAYERS"
        android:textColor="#FFC107"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>

    <LinearLayout
        android:id="@+id/playersOptions"
        android:layout_below="@id/txtSelectPlayers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btn2p"
            style="@style/Widget.Button.LobbyOption"
            android:text="2P/3P/4P"
            android:textSize="14sp"
            android:backgroundTint="#1E88E5"/>

        <Button
            android:id="@+id/btnTeamUp"
            style="@style/Widget.Button.LobbyOption"
            android:text="Team Up"
            android:textSize="14sp"
            android:backgroundTint="#43A047"
            android:layout_marginStart="10dp"/>

    </LinearLayout>

    <!-- Create / Join Tabs -->
    <LinearLayout
        android:id="@+id/createJoinTabs"
        android:layout_below="@id/playersOptions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnCreate"
            style="@style/Widget.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Create"
            android:textSize="14sp"
            android:backgroundTint="#FFD600"/>

        <Button
            android:id="@+id/btnJoin"
            style="@style/Widget.Button.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Join"
            android:textSize="14sp"
            android:backgroundTint="#616161"
            android:textColor="#fff"
            android:layout_marginStart="12dp"/>
    </LinearLayout>

    <!-- Select Lobby -->
    <TextView
        android:id="@+id/txtSelectLobby"
        android:layout_below="@id/createJoinTabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SELECT LOBBY"
        android:textColor="#FFC107"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"/>

    <!-- Entry Coins -->
    <LinearLayout
        android:id="@+id/entryLayout"
        android:layout_below="@id/txtSelectLobby"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/btnMinus"
            style="@style/Widget.Button.Round"
            android:text="-"
            android:textSize="14sp"
            android:backgroundTint="#FF5722"/>

        <TextView
            android:id="@+id/txtEntryCoins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginHorizontal="20dp"/>

        <Button
            android:id="@+id/btnPlus"
            style="@style/Widget.Button.Round"
            android:text="+"
            android:textSize="14sp"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>

    <!-- Next Button -->
    <Button
        android:id="@+id/btnNext"
        android:layout_below="@id/entryLayout"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="30dp"
        android:text="Next"
        android:textStyle="bold"
        android:textSize="18sp"
        android:backgroundTint="#2196F3"
        android:textColor="#fff"
        android:padding="14dp"
        android:elevation="6dp"
        android:background="@drawable/bg_button_rounded"/>
</RelativeLayout>