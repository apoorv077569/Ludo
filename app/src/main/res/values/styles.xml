<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GameTab" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">#1D2E85</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="OutlinedButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_outlined</item>
        <item name="android:textColor">#000000</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>


</resources>