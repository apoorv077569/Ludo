<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ludoBoardLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#001B5D">

    <!-- Prize & Timer Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:background="#021E6A"
        android:gravity="center"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_trophy" />

        <TextView
            android:id="@+id/prizePool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prize Pool ₹0.6"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"/>

        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:52"
            android:textColor="#00FF00"
            android:textSize="14sp"/>
    </LinearLayout>

    <!-- Top Player Row (john & dow) -->
    <LinearLayout
        android:id="@+id/topPlayerRow"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Blue Player -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/playerBlue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="john"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_crown"/>
        </LinearLayout>

        <!-- Red Player -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/playerRed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dow"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_crown"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Ludo Grid 15x15 -->
    <GridLayout
        android:id="@+id/ludoGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:rowCount="15"
        android:columnCount="15"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/topPlayerRow"
        app:layout_constraintBottom_toTopOf="@id/bottomPlayerRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="1:1" />

    <!-- Bottom Player Row (Rajeev & Poul) -->
    <LinearLayout
        android:id="@+id/bottomPlayerRow"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Yellow Player -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/playerYellow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rajeev"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_crown"/>
        </LinearLayout>

        <!-- Green Player -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:id="@+id/playerGreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Poul"
                android:textColor="#FFFFFF"
                android:textSize="14sp"/>
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_crown"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
