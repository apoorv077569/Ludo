<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B2A63">

    <!-- Logo at Top -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        android:src="@drawable/play_zelo_logo"
        android:contentDescription="App Logo" />

    <!-- Side-by-side Lottie animations -->
    <LinearLayout
        android:id="@+id/animationRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/logo"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Dice Animation on Top -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/ludoDiceAnim"
            android:layout_width="300dp"
            android:layout_height="200dp"
            app:lottie_rawRes="@raw/dice"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <!-- Gap -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <!-- Boy Running Animation Below -->
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/boyRunningAnim"
            android:layout_width="200dp"
            android:layout_height="200dp"
            app:lottie_rawRes="@raw/cute_boy_running"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />
    </LinearLayout>

    <!-- App Title -->
    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/animationRow"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="WELCOME TO PlayZelo"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:alpha="0" />

    <!-- Loading Bar -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/loadingBar"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        app:lottie_rawRes="@raw/loading"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />
</RelativeLayout>
