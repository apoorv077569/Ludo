<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF">

    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="#073AAE"
            android:elevation="6dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerVertical="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_back"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ludo "
                    android:textColor="@android:color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Play"
                    android:textColor="#FFC107"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zelo"
                    android:textColor="@android:color/white"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="8dp"
                android:text="Play • Connect • Enjoy"
                android:textColor="#DCE7FF"
                android:textSize="9sp" />
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="28dp"
                android:paddingEnd="16dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Choose Players"
                    android:textColor="#092C73"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="Get ready for a fun Ludo match!"
                    android:textColor="#75839C"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="5dp"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="38dp"
                        android:layout_height="5dp"
                        android:background="#2196F3" />
                    <View
                        android:layout_width="38dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="4dp"
                        android:background="#F44336" />
                    <View
                        android:layout_width="38dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="4dp"
                        android:background="#FFC107" />
                    <View
                        android:layout_width="38dp"
                        android:layout_height="5dp"
                        android:layout_marginStart="4dp"
                        android:background="#22B573" />
                </LinearLayout>

                <!-- Both cards stay side-by-side and share the available width -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardTwoPlayer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#0B4ACB"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="58dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:contentDescription="Red Player Token"
                                    android:src="@drawable/red_token" />

                                <ImageView
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:contentDescription="Blue Player Token"
                                    android:src="@drawable/blue_token" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="2 Players"
                                android:textColor="@android:color/white"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="Challenge a friend"
                                android:textColor="#DCE8FF"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnTwoPlayer"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="15dp"
                                android:background="@drawable/bg_play_button"
                                android:gravity="center"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:stateListAnimator="@null"
                                android:text="▶  PLAY"
                                android:textAllCaps="false"
                                android:textColor="#0B4ACB"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardFourPlayer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="#0B4ACB"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="35dp"
                                    android:layout_height="52dp"
                                    android:contentDescription="Red Player Token"
                                    android:src="@drawable/red_token" />

                                <ImageView
                                    android:layout_width="35dp"
                                    android:layout_height="52dp"
                                    android:contentDescription="Blue Player Token"
                                    android:src="@drawable/blue_token" />

                                <ImageView
                                    android:layout_width="35dp"
                                    android:layout_height="52dp"
                                    android:contentDescription="Green Player Token"
                                    android:src="@drawable/green_token" />

                                <ImageView
                                    android:layout_width="35dp"
                                    android:layout_height="52dp"
                                    android:contentDescription="Yellow Player Token"
                                    android:src="@drawable/yellow_token" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="4 Players"
                                android:textColor="@android:color/white"
                                android:textSize="19sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:maxLines="2"
                                android:text="More friends, more fun"
                                android:textColor="#DCE8FF"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/btnFourPlayer"
                                android:layout_width="match_parent"
                                android:layout_height="46dp"
                                android:layout_marginTop="15dp"
                                android:background="@drawable/bg_play_button"
                                android:gravity="center"
                                android:minWidth="0dp"
                                android:minHeight="0dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:stateListAnimator="@null"
                                android:text="▶  PLAY"
                                android:textAllCaps="false"
                                android:textColor="#0B4ACB"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="—  ROLL • MOVE • WIN  —"
                    android:textColor="#8090AA"
                    android:textSize="11sp"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
