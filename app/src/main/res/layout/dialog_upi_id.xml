<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0E2A47"
    android:gravity="center"
    android:layout_margin="20dp">

    <!-- Title Text -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your UPI ID"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:paddingBottom="10dp"
        android:textStyle="bold" />

    <!-- Instruction Text -->
    <TextView
        android:id="@+id/instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter a valid UPI ID"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:paddingBottom="20dp" />

    <!-- UPI ID Input Field -->
    <EditText
        android:id="@+id/upi_id_edittext"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="UPI ID"
        android:inputType="textEmailAddress"
        android:textColor="#000000"
        android:background="@drawable/edit_text_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:textSize="16sp"
        android:textColorHint="#AAAAAA"
        android:layout_marginBottom="12dp" />

    <!-- Instruction below input -->
    <TextView
        android:id="@+id/upi_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="In PhonePe, the user's registered mobile no. followed by @phonepe"
        android:textColor="#D0D0D0"
        android:textSize="14sp"
        android:paddingTop="10dp"
        android:layout_marginBottom="20dp" />

    <!-- Proceed Button -->
    <Button
        android:id="@+id/proceed_button"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="PROCEED"
        android:textColor="#FFFFFF"
        android:background="#FFA500"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:padding="10dp" />

</LinearLayout>
