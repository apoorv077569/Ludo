<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#ffff"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 🔹 Top Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#001B5D"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <!-- App Logo -->
                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:src="@drawable/play_zelo_logo"
                    android:scaleType="fitStart"
                    android:contentDescription="PlayZelo Logo" />

                <!-- Notification Icon -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notification"
                    android:layout_marginEnd="12dp" />

                <!-- Wallet Balance -->
                <!-- Wallet Balance Button -->
                <LinearLayout
                    android:id="@+id/btnWalletBalanceContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_white_rounded"
                android:paddingHorizontal="10dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/withdraw"
                    android:layout_marginEnd="4dp" />

            </LinearLayout>

                <!-- Deposit Now Button -->
                <LinearLayout
                    android:id="@+id/btnDepositNow"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_white_rounded"
                    android:paddingHorizontal="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="4dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/deposit"
                        android:layout_marginEnd="6dp" />


                </LinearLayout>
            </LinearLayout>

            <!-- 🔹 Banner with Animation -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <!-- 🖼️ Background Banner Image -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ludo_banner_image"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:padding="0dp" />

                <!-- 🎲 Dice Animation (larger and centered) -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieDice"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center"
                    app:lottie_rawRes="@raw/dice_animation"
                    app:lottie_loop="true"
                    app:lottie_autoPlay="true" />

                <!-- 💥 Conflict Animation (larger and centered) -->
                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieConflict"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    app:lottie_rawRes="@raw/conflict_animation"
                    app:lottie_loop="true"
                    app:lottie_autoPlay="true" />

                <!-- ▶️ Play Now Button (bottom centered) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@android:color/transparent"
                    android:elevation="4dp">

                    <Button
                        android:id="@+id/btnPlayNow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Play Now"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:textColor="#ffffff"
                        android:backgroundTint="#001A7D" />
                </LinearLayout>
            </FrameLayout>

            <!-- 🔹 Cash Offers Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add cash offers (₹)"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#000000"
                android:background="#F5F5F5"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:paddingStart="16dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="12dp"
                android:background="#F5F5F5"
                android:alignmentMode="alignMargins"
                android:columnOrderPreserved="false">

                <!-- ₹10 Card -->
                <include
                    layout="@layout/item_cash_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp" />

                <!-- ₹20 Card -->
                <include
                    layout="@layout/item_cash_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp" />

                <!-- ₹100 Card -->
                <include
                    layout="@layout/item_cash_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp" />

                <!-- ₹500 Card -->
                <include
                    layout="@layout/item_cash_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp" />
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp">

                <!-- 🔝 Title Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Complete and Get Cash"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/3 completed"
                        android:textColor="#000000"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 🎯 Horizontal Scrollable Cards -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- 🟢 Card 1 -->
                        <LinearLayout
                            android:layout_width="180dp"
                            android:layout_height="160dp"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_marginRight="8dp"
                            android:layout_gravity="center"
                            android:backgroundTintMode="src_in"
                            android:clipToPadding="false"
                            android:layout_marginBottom="6dp"
                            android:layout_marginTop="6dp"
                            android:elevation="2dp"
                            android:backgroundTint="#00B980"
                            android:background="@drawable/bg_card_rounded">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Get upto ₹25"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Make 1st deposit"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp" />

                            <Button
                                android:id="@+id/cardDepositNowButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="Deposit Now"
                                android:textSize="12sp"
                                android:textColor="#FFFFFF"
                                android:layout_marginTop="12dp"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:backgroundTint="#C5172E"
                                android:background="@drawable/bg_red_button" />

                        </LinearLayout>

                        <!-- 🟣 Card 2 -->
                        <LinearLayout
                            android:layout_width="180dp"
                            android:layout_height="160dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_card_rounded"
                            android:backgroundTint="#77BEF0"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_marginBottom="6dp"
                            android:layout_marginTop="6dp"
                            android:elevation="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Get ₹2"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Play 3 games"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="14dp">

                                <Button
                                    android:id="@+id/cardPlayNowButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:text="Play Now"
                                    android:textSize="11sp"
                                    android:textColor="#ffffff"
                                    android:backgroundTint="#C5172E"
                                    android:background="@drawable/bg_red_button"                                    android:paddingHorizontal="16dp"
                                    android:paddingVertical="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1/3"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:layout_marginStart="8dp" />
                            </LinearLayout>

                        </LinearLayout>


                        <!-- 🔵 Add 3rd Card similarly here -->
                        <LinearLayout
                            android:layout_width="180dp"
                            android:layout_height="160dp"
                            android:orientation="vertical"
                            android:background="@drawable/bg_card_rounded"
                            android:backgroundTint="#FFB4B4"
                            android:padding="12dp"
                            android:layout_marginEnd="8dp"
                            android:layout_marginBottom="6dp"
                            android:layout_marginTop="6dp"
                            android:elevation="2dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Get ₹3"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Play 5 games"
                                android:textColor="#FFFFFF"
                                android:textSize="14sp"
                                android:layout_marginTop="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="14dp">

                                <Button
                                    android:id="@+id/cardPlayNowButton1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:text="Play Now"
                                    android:textSize="11sp"
                                    android:textColor="#ffffff"
                                    android:backgroundTint="#C5172E"
                                    android:background="@drawable/bg_red_button"                                    android:paddingHorizontal="16dp"
                                    android:paddingVertical="6dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1/5"
                                    android:textColor="#FFFFFF"
                                    android:textSize="12sp"
                                    android:layout_marginStart="8dp" />
                            </LinearLayout>

                        </LinearLayout>


                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>



            <!-- 🔸 Referral Code Banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_referral_banner"
                android:gravity="center_horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_refer"
                    android:contentDescription="Referral Icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Do you have a referral code?"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Use Code"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- 🔸 Game Invite Code Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_game_invite"
                android:padding="12dp"
                android:layout_marginTop="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_refer"
                    android:contentDescription="Invite Icon" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Got a game invite code from a friend?"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <Button
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter Code"
                    android:textColor="#512DA8"
                    android:backgroundTint="@android:color/white"
                    android:elevation="0dp" />
            </LinearLayout>

            <!-- 🔸 Instant Withdraw Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:background="@android:color/white">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/shield"
                    android:contentDescription="Shield Icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Instant withdrawals"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 👇 Add this for fragments -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation" />

    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation" />


    <!-- 🔹 Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@android:color/white"
        app:menu="@menu/menu_bottom_nav"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
